rules_version = '2';

// Regole pensate per una lega fra amici: chi e' autenticato (anche in forma
// anonima) e conosce il codice della lega puo' leggerla e scriverci.
// I codici sono casuali a 6 caratteri su un alfabeto di 31 simboli
// (circa 900 milioni di combinazioni), quindi non si indovinano a tentativi.
//
// Nessuno puo' cancellare una lega dal client: si fa dalla console Firebase.
// Non inserire dati personali: chi ha il link puo' leggerli.

service cloud.firestore {
  match /databases/{database}/documents {

    // Scadenza del giro di buste chiuse. Se la lega non usa quella modalita'
    // il valore manca: il default 0 rende le offerte leggibili subito, ma in
    // quel caso non ce ne sono.
    function scadenzaBuste(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId))
        .data.get('sealed', {}).get('scadenza', 0);
    }

    match /leagues/{leagueId} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null;
      // Solo chi ha creato la lega puo' cancellarla.
      allow delete: if request.auth != null
        && resource.data.adminUid == request.auth.uid;

      match /matchdays/{matchdayId} {
        allow read, create, update: if request.auth != null;
        allow delete: if request.auth != null;
      }

      // Offerte a busta chiusa: un documento per persona.
      //
      // Ognuno scrive e rilegge SOLO le proprie finche' la scadenza del giro
      // non e' passata; da quel momento diventano leggibili a tutti, perche'
      // serve poterle risolvere e verificare.
      //
      // E' segretezza vera: nasconderle nell'interfaccia non basterebbe,
      // chiunque sa aprire la console del browser vedrebbe le offerte altrui.
      match /bids/{uid} {
        allow write: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null && (
          request.auth.uid == uid
          || request.time.toMillis() >= scadenzaBuste(leagueId)
        );
      }

      // Presenza: un battito ogni 20 secondi, un documento per persona.
      // Tutti leggono chi e' collegato, ma ognuno puo' scrivere solo il
      // proprio: nessuno puo' fingere che un altro sia online.
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Iscrizioni alle notifiche push: un documento per dispositivo.
    //
    // Rigorosamente private. Un endpoint push e' una capability: chi ce
    // l'ha puo' mandare notifiche a quel telefono, quindi non deve essere
    // leggibile dagli altri partecipanti. A leggerle e' solo la Cloud
    // Function, che gira con l'Admin SDK e queste regole non le vede.
    match /pushSubs/{uid}/devices/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tutto il resto e' chiuso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
